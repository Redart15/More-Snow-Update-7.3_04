{
  "schemaVersion": 1,
  "id": "moresnow",
  "version": "${version}",
  "name": "More Snow",
  "description": "Add more snow to BTA, as well support for other layers.",
  "authors": [
    "Helinos",
		"Redart15"
  ],
	"icon": "icon.png",
  "contact": {
    "sources": "https://github.com/Helinos/More-Snow",
    "issues": "https://github.com/Helinos/More-Snow/issues"
  },
  "license": "LGPL-3.0",
  "environment": "*",
