{
  "required": true,
  "mixinextras": {
    "minVersion": "0.5.0"
  },
  "package": "net.helinos.moresnow.mixin",
  "compatibilityLevel": "JAVA_${java}",
  "injectors": {
    "defaultRequire": 1
  },
  "mixins": [
    "BlockLogicLayerLeavesMixin",
    "BlockLogicLayerSnowMixin",
    "ItemBlockLayerMixin",
    "ItemBlockLeaveLayerMixin",
    "ItemMixinNameAdjustment",
    "accessor.BlockAccessor",
    "accessor.ItemBlockAccessor",
    "weather.WeatherMixin",
    "weather.WeatherSnowMixin"
  ],
  "client": [
    "BlockModelGrassMixin",
    "BlockModelLayerMixinFixSideRenderer",
    "particle.PlayerControllerMixinSnowyParticle"
  ],
  "server": [
    "particle.ServerPlayerControllerMixinSnowyParticle"
  ]
}
